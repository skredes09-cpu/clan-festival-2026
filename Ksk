<style>
:root{--bg:#0c0918;--panel:rgba(255,255,255,.06);--line:rgba(255,255,255,.14);--text:#f3effa;--mute:#a79fc0;--gold:#f5c542;--green:#34d399;--red:#f87171;--violet:#8b5cf6}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:"DM Sans",system-ui,sans-serif;color:var(--text);background:var(--bg);line-height:1.6;
background-image:radial-gradient(60vw 40vh at 15% -5%,rgba(139,92,246,.35),transparent),radial-gradient(50vw 40vh at 100% 20%,rgba(245,197,66,.14),transparent),radial-gradient(40vw 30vh at 0% 80%,rgba(52,211,153,.10),transparent);background-attachment:fixed}
h1,h2,h3{font-family:"Bricolage Grotesque",system-ui,sans-serif;line-height:1.1;margin:0}
main{position:relative;z-index:1;max-width:880px;margin:0 auto;padding:0 18px 60px}
section{padding:44px 0 6px}
h2{font-size:clamp(1.6rem,5vw,2.2rem);margin-bottom:14px}
.hero{padding-top:6px}
.hero h1{font-size:clamp(2.6rem,12vw,5.4rem);font-weight:800;letter-spacing:-.02em}
.hero h1 span{display:block;color:var(--gold)}
.sub{color:var(--mute);margin:12px 0 22px;max-width:48ch}
.count{display:flex;gap:10px;margin:20px 0}
.count div{flex:1;max-width:96px;text-align:center;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px 4px;backdrop-filter:blur(10px)}
.count b{display:block;font:800 1.7rem "Bricolage Grotesque",sans-serif}
.count small{color:var(--mute);font-size:.75rem}
.btns{display:flex;flex-wrap:wrap;gap:10px}
a.btn,button{font:700 1rem "DM Sans",sans-serif;border:0;border-radius:12px;padding:12px 20px;cursor:pointer;text-decoration:none;display:inline-block}
.primary{background:linear-gradient(135deg,var(--gold),#ff9d3d);color:#1b1230}
.ghost{background:var(--panel);color:var(--text);border:1px solid var(--line)}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:20px;backdrop-filter:blur(14px)}
label{display:block;font-size:.9rem;color:var(--mute);margin:12px 0 4px}
input{width:100%;font:1rem "DM Sans",sans-serif;color:var(--text);background:rgba(0,0,0,.35);border:1px solid var(--line);border-radius:10px;padding:11px 12px}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.msg{margin-top:12px;min-height:1.4em;font-size:.95rem}
.ok{color:var(--green)}.err{color:var(--red)}
.who{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:10px 6px;border-bottom:1px solid var(--line)}
th{color:var(--mute);font-weight:500;font-size:.85rem}
td.n,th.n{text-align:right}
.scroll{overflow-x:auto}
.top1{color:var(--gold);font-weight:700}
.pts{font:800 1.1rem "Bricolage Grotesque",sans-serif}
ul{padding-left:20px;margin:8px 0}
.tag{display:inline-block;padding:2px 10px;border-radius:99px;font-size:.8rem;border:1px solid var(--line)}
.pending{color:var(--gold)}.approved{color:var(--green)}.rejected{color:var(--red)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.person{background:var(--panel);border:1px solid var(--line);border-radius:22px;overflow:hidden;backdrop-filter:blur(14px)}
.person.amb{border-color:rgba(245,197,66,.6);box-shadow:0 0 40px rgba(245,197,66,.12)}
.ph{position:relative;aspect-ratio:4/5;background:linear-gradient(160deg,#2a1d52,#14102a);display:grid;place-items:center}
.ph .ini{font:800 3.4rem "Bricolage Grotesque",sans-serif;color:rgba(255,255,255,.35)}
.ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 20%}
.pb{padding:18px}
.role{display:inline-block;font-size:.8rem;font-weight:700;color:#1b1230;background:var(--gold);border-radius:99px;padding:3px 12px;margin-bottom:8px}
.person.ldr .role{background:var(--violet);color:#fff}
.pb h3{font-size:1.5rem;margin-bottom:8px}
.pb p{margin:0 0 10px;color:var(--mute);font-size:.95rem}
dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:4px 12px;font-size:.9rem}
dt{color:var(--mute)}dd{margin:0;word-break:break-all}
footer{text-align:center;color:var(--mute);font-size:.85rem;padding:30px 18px calc(30px + env(safe-area-inset-bottom))}
.hidden{display:none}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

.hang{display:flex;flex-direction:column;align-items:center;padding-top:env(safe-area-inset-top,0px);margin:0 -18px}
#banner{width:min(100%,520px);display:block;cursor:pointer;touch-action:manipulation}
.hint{margin:0 0 6px;font-size:.85rem;color:#fff;text-align:center;text-shadow:0 1px 6px rgba(0,0,0,.55)}
#fxWrap{position:fixed;inset:0;z-index:50;pointer-events:none}
#fx,#fxT{position:absolute;inset:0;width:100%;height:100%}
.sky{position:absolute;top:0;left:0;right:0;height:340px;overflow:hidden;z-index:0;pointer-events:none;background:linear-gradient(180deg,#2f86e6 0%,#69b3f3 45%,#a8d5fa 75%,#d6ecff 100%);-webkit-mask-image:linear-gradient(#000 40%,transparent 85%);mask-image:linear-gradient(#000 40%,transparent 85%)}
.cloud{position:absolute;left:0;top:var(--t);width:var(--w);height:calc(var(--w)*.3);background:#fff;border-radius:99px;opacity:var(--o);filter:blur(5px);animation:drift var(--d) linear var(--dl) infinite;will-change:transform}
.cloud::before,.cloud::after{content:"";position:absolute;background:#fff;border-radius:50%}
.cloud::before{width:42%;height:150%;left:14%;top:-60%}
.cloud::after{width:34%;height:120%;left:50%;top:-40%}
@keyframes drift{from{transform:translateX(-300px)}to{transform:translateX(calc(100vw + 300px))}}
@media (prefers-reduced-motion:reduce){.cloud{animation:none;left:var(--x)}}
.skyline{position:absolute;top:190px;left:0;width:100%;height:120px;z-index:0;pointer-events:none}
.flag{transform-box:fill-box;transform-origin:0 50%;animation:flagw 2.6s ease-in-out infinite alternate}
@keyframes flagw{from{transform:skewY(-9deg) scaleX(1)}to{transform:skewY(9deg) scaleX(.86)}}
@media (prefers-reduced-motion:reduce){.flag{animation:none}}
</style>
</head>
